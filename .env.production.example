# Names only. Do not put real secrets in this file.
# Copy to an untracked file, or store the secret values in AWS Secrets Manager.

ENVIRONMENT=production
DB_AUTO_MIGRATE=false

# PostgreSQL. Not SQLite. Not localhost. Secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/quantpilot

# HTTPS browser origins. Not localhost.
ALLOWED_ORIGINS=https://app.example.com

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

LAKE_BACKEND=s3
LAKE_BUCKET=quantpilot-staging-lake
LAKE_REGION=us-east-1
LAKE_ENDPOINT_URL=

KAFKA_BOOTSTRAP_SERVERS=10.40.10.10:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPLICATION_FACTOR=1
KAFKA_RESEARCH_PARTITIONS=3

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=quantpilot-api

RESEARCH_LEASE_SECONDS=120
RESEARCH_HEARTBEAT_SECONDS=15
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_MAX_QUEUED_JOBS=100

# Build-time only. Next.js does not read this at container start.
# NEXT_PUBLIC_API_URL=https://app.example.com
