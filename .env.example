# QuantPilot environment template — copy values into service-specific files.
# NEVER commit real secrets. This file contains names and placeholders only.
#
#   backend/.env
#   frontend/.env.local
#
# Required / optional / environment class is documented in ENV_VARIABLES.md
# and docs/PHASE_12_HARDENING.md.

# --- Required (production) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/quantpilot
# OPENAI_API_KEY=
# SEC_EDGAR_USER_AGENT=QuantPilot/1.0 (you@example.com)
# JWT_SECRET_KEY=
# ALLOWED_ORIGINS=https://your-frontend.example
# NEXT_PUBLIC_API_URL=https://your-api.example

# --- Optional infrastructure ---
# REDIS_URL=redis://localhost:6379/0
# ENVIRONMENT=development
# PORT=8000
# QUANTPILOT_ROOT=

# --- Auth ---
# JWT_EXPIRE_DAYS=7
# JWT_ALGORITHM=HS256

# --- Schedulers (production-only to enable; tests keep these off) ---
# BRIEFING_ENABLED=true
# ALERTS_ENABLED=true
# INVESTIGATIONS_SWEEP_ENABLED=false

# --- MCP / OpenClaw (optional; OpenClaw is targeted research only) ---
# BROWSER_MCP_ENABLED=true
# OPENCLAW_BROWSER_URL=http://127.0.0.1:18791
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=
# OPENCLAW_BROWSER_PROFILE=openclaw
# OPENCLAW_IR_FALLBACK=false

# --- LLM / request safeguards ---
# MAX_LLM_CALLS_PER_INVESTIGATION=24
# MAX_TOKENS_PER_INVESTIGATION=80000
# MAX_RETRIES=1
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=8
# MAX_REQUEST_BODY_BYTES=1000000
# SWEEP_LOCK_TTL_SECONDS=180

# --- Observability (optional) ---
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=quantpilot
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
