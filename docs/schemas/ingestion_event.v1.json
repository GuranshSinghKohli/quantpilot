{
  "$defs": {
    "CompanyEvent": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "dedup_key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Dedup Key",
          "type": "string"
        },
        "domain": {
          "const": "company",
          "title": "Domain",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "external_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "original": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Original",
          "type": "object"
        },
        "record": {
          "$ref": "#/$defs/CompanyRecord"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/DataSourceType"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "run_id",
        "source",
        "source_type",
        "external_id",
        "dedup_key",
        "content_hash",
        "ingested_at",
        "original",
        "domain",
        "record"
      ],
      "title": "CompanyEvent",
      "type": "object"
    },
    "CompanyRecord": {
      "additionalProperties": false,
      "properties": {
        "cik": {
          "title": "Cik",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "exchange": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticker"
        },
        "tickers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tickers",
          "type": "array"
        }
      },
      "required": [
        "source",
        "content_hash",
        "ingested_at",
        "external_id",
        "cik",
        "name"
      ],
      "title": "CompanyRecord",
      "type": "object"
    },
    "DataSourceType": {
      "description": "What kind of data a source provides. ``news`` and ``market_data`` match\n``app.domain.enums.SourceType`` so news rows map onto ``sources`` directly.",
      "enum": [
        "news",
        "market_data",
        "reference_data"
      ],
      "title": "DataSourceType",
      "type": "string"
    },
    "JsonValue": {},
