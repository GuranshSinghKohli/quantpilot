{
  "additionalProperties": false,
  "properties": {
    "author": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "external_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "publisher": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "tickers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tickers",
      "type": "array"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "source",
    "content_hash",
    "ingested_at",
    "external_id",
    "title",
    "url",
    "published_at"
  ],
  "title": "NewsRecord",
  "type": "object"
}
