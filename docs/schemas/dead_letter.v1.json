{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Value on the DLQ topic: the original bytes plus enough context to debug.",
  "properties": {
    "component": {
      "enum": [
        "ingestor",
        "lake_writer",
        "loader"
      ],
      "title": "Component",
      "type": "string"
    },
    "dlq_id": {
      "format": "uuid",
      "title": "Dlq Id",
      "type": "string"
    },
    "error_details": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Error Details",
      "type": "array"
    },
    "error_message": {
      "maxLength": 4000,
      "title": "Error Message",
      "type": "string"
    },
    "error_type": {
      "title": "Error Type",
      "type": "string"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "failed_at": {
      "format": "date-time",
      "title": "Failed At",
      "type": "string"
    },
    "failure_reason": {
      "title": "Failure Reason",
      "type": "string"
    },
    "first_failed_at": {
      "format": "date-time",
      "title": "First Failed At",
      "type": "string"
    },
    "offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offset"
    },
    "original_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Key"
    },
    "original_topic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Topic"
    },
    "original_truncated": {
      "default": false,
      "title": "Original Truncated",
      "type": "boolean"
    },
    "original_value": {
      "title": "Original Value",
      "type": "string"
    },
    "partition": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Partition"
    },
    "retry_count": {
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "value_encoding": {
      "enum": [
        "utf8",
        "base64"
      ],
      "title": "Value Encoding",
      "type": "string"
    }
  },
  "required": [
    "dlq_id",
    "component",
    "failure_reason",
    "error_type",
    "error_message",
    "original_value",
    "value_encoding",
    "retry_count",
    "first_failed_at",
    "failed_at"
  ],
  "title": "DeadLetter",
  "type": "object"
}
