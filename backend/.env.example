# SEC EDGAR requires a descriptive User-Agent (company/app + contact email)
SEC_EDGAR_USER_AGENT=QuantPilot/1.0 (your-email@example.com)

# Required for full agent analysis and ChromaDB embeddings
OPENAI_API_KEY=sk-your-key-here

# Comma-separated CORS origins (add your Vercel URL after deploy)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 7 — database (Postgres in production; SQLite used locally if unset)
# DATABASE_URL=postgresql://user:pass@localhost:5432/quantpilot

# Phase 7 — JWT auth (set a long random string in production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# JWT_EXPIRE_DAYS=7

# Phase 8 — daily portfolio briefings (APScheduler, UTC)
BRIEFING_ENABLED=true
BRIEFING_HOUR_UTC=12
BRIEFING_MINUTE_UTC=0
# BRIEFING_MAX_HOLDINGS=12

# Phase 9 — Redis + smart alerts
# REDIS_URL=redis://localhost:6379/0
ALERTS_ENABLED=true
ALERT_INTERVAL_MINUTES=15
# QUOTE_CACHE_TTL_SECONDS=60

# PRD v3 Phase 11 — scheduled investigation sweep (off by default)
INVESTIGATIONS_SWEEP_ENABLED=false
# INVESTIGATION_SWEEP_INTERVAL_MINUTES=30
# INVESTIGATION_SWEEP_MAX_PER_RUN=5
# INVESTIGATION_COOLDOWN_HOURS=6
# INVESTIGATION_VOL_Z_THRESHOLD=1.5
# INVESTIGATION_IDIO_PCT=1.0
# INVESTIGATION_BENCHMARK=SPY
# INVESTIGATION_NOISE_PCT=1.5

# PRD v3 Phase 12 — materiality notifications (in-app AlertEvents)
INVESTIGATION_NOTIFY_ENABLED=true
# INVESTIGATION_NOTIFY_MIN_SCORE=45
# INVESTIGATION_NOTIFY_MIN_Z=2.0
# INVESTIGATION_NOTIFY_MIN_DEPTH=standard
# INVESTIGATION_NOTIFY_COOLDOWN_HOURS=6
# ALERT_EMAIL_ENABLED=false

# Browser MCP + OpenClaw (IR / transcripts / shareholder letters; repo Phase 11)
BROWSER_MCP_ENABLED=true
# MCP_BROWSER_TIMEOUT_SECONDS=45
# Optional OpenClaw loopback browser control (preferred when Gateway is running):
# OPENCLAW_BROWSER_URL=http://127.0.0.1:18791
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# OPENCLAW_GATEWAY_PASSWORD=
# OPENCLAW_BROWSER_PROFILE=openclaw
# OPENCLAW_USE_CLI=false
# OPENCLAW_CLI_PATH=openclaw

# Phase 11.1 — Portfolio Auto-Sync (broker position import)
# Existing-session profile OpenClaw uses to read the user's own signed-in
# browser tab for the "auto-snapshot" sync option (paste always works too):
# OPENCLAW_BROWSER_PROFILE_EXISTING=user

# Phase 12 — Observability (all optional; no-ops when unset)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=quantpilot
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=quantpilot-api

# Optional: override monorepo root if MCP server path differs on your host
# QUANTPILOT_ROOT=/path/to/quantpilot
