# SEC EDGAR requires a descriptive User-Agent (company/app + contact email)
SEC_EDGAR_USER_AGENT=QuantPilot/1.0 (your-email@example.com)

# Required for full agent analysis and ChromaDB embeddings
OPENAI_API_KEY=sk-your-key-here

# Comma-separated CORS origins (add your Vercel URL after deploy)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Postgres in production; SQLite at backend/data/quantpilot.db if unset).
# Schema is managed by Alembic: `make migrate` or `cd backend && alembic upgrade head`.
# DATABASE_URL=postgresql://quantpilot:quantpilot@localhost:5432/quantpilot
# DB_AUTO_MIGRATE unset = migrate on startup only when ENVIRONMENT=development
# DB_AUTO_MIGRATE=false

# JWT auth (set a long random string in production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# JWT_EXPIRE_DAYS=7

# Redis (optional; in-memory fallback when unset or unreachable)
# REDIS_URL=redis://localhost:6379/0
# QUOTE_CACHE_TTL_SECONDS=60

# PRD v3 Phase 11 — scheduled investigation sweep (off by default)
INVESTIGATIONS_SWEEP_ENABLED=false
# INVESTIGATION_SWEEP_INTERVAL_MINUTES=30
# INVESTIGATION_SWEEP_MAX_PER_RUN=5
# INVESTIGATION_COOLDOWN_HOURS=6
# INVESTIGATION_VOL_Z_THRESHOLD=1.5
# INVESTIGATION_IDIO_PCT=1.0
# INVESTIGATION_BENCHMARK=SPY
# INVESTIGATION_NOISE_PCT=1.5
# MAX_INVESTIGATION_ITERATIONS=2
# MAX_CHALLENGE_LOOPS=1

# PRD v3 Phase 12 — materiality notifications (in-app AlertEvents)
INVESTIGATION_NOTIFY_ENABLED=true
# INVESTIGATION_NOTIFY_MIN_SCORE=45
# INVESTIGATION_NOTIFY_MIN_Z=2.0
# INVESTIGATION_NOTIFY_MIN_DEPTH=standard
# INVESTIGATION_NOTIFY_COOLDOWN_HOURS=6
# ALERT_EMAIL_ENABLED=false

# Browser MCP + OpenClaw (IR / transcripts / shareholder letters; repo Phase 11)
BROWSER_MCP_ENABLED=true
# MCP_BROWSER_TIMEOUT_SECONDS=45
# MAX_BROWSER_TASKS_PER_INVESTIGATION=2
# MAX_BROWSER_PAGES_PER_TASK=4
# MAX_BROWSER_RETRIES=1
# BROWSER_NAV_TIMEOUT_SECONDS=20
# BROWSER_DISCOVERY_TIMEOUT_SECONDS=30
# BROWSER_EXTRACT_TIMEOUT_SECONDS=15
# Optional OpenClaw loopback browser control (preferred when Gateway is running):
# OPENCLAW_BROWSER_URL=http://127.0.0.1:18791
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# OPENCLAW_GATEWAY_PASSWORD=
# OPENCLAW_BROWSER_PROFILE=openclaw
# OPENCLAW_USE_CLI=false
# OPENCLAW_CLI_PATH=openclaw

# Service identity + production hardening
# ENVIRONMENT=development
# SERVICE_NAME=quantpilot-api
# SERVICE_VERSION=0.1.0
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=8
# MAX_REQUEST_BODY_BYTES=1000000
# MAX_LLM_CALLS_PER_INVESTIGATION=24
# MAX_TOKENS_PER_INVESTIGATION=80000
# MAX_RETRIES=1
# SWEEP_LOCK_TTL_SECONDS=180

# Phase 12 — Observability (all optional; no-ops when unset)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=quantpilot
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=quantpilot-api

# Optional: override monorepo root if MCP server path differs on your host
# QUANTPILOT_ROOT=/path/to/quantpilot

# Optional Neo4j projection (Phase 3.1). Empty = disabled; the API starts without it.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=quantpilot-dev-only
# NEO4J_DATABASE=neo4j

# Ingestion source adapters (python -m app.pipeline ingest …). Leave empty unless ingesting.
# Massive (formerly Polygon.io) key for news + daily bars; never commit a real value.
NEWS_API_KEY=
MARKET_API_KEY=
